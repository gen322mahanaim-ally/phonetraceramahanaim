// Firestore Security Rules for Phone Trace App
// Copy this to Firebase Console > Firestore Database > Rules

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user is admin
    function isAdmin() {
      return isAuthenticated() && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    // Helper function to check if user owns the device
    function ownsDevice(deviceId) {
      return isAuthenticated() &&
             (isAdmin() || 
              get(/databases/$(database)/documents/devices/$(deviceId)).data.owner == request.auth.uid);
    }
    
    // Users collection - only admins can read all, users can read their own
    match /users/{userId} {
      allow read: if isAuthenticated() && (isAdmin() || request.auth.uid == userId);
      allow write: if isAdmin() || request.auth.uid == userId;
      allow delete: if isAdmin();
    }
    
    // Devices collection - read allowed for authenticated users, write for admins
    match /devices/{deviceId} {
      allow read: if isAuthenticated();
      allow create: if isAdmin();
      allow update: if isAdmin() || ownsDevice(deviceId);
      allow delete: if isAdmin();
    }
    
    // Locations collection - read for authenticated, write for device owner/admin
    match /locations/{locationId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && 
                       (isAdmin() || 
                        request.resource.data.deviceId != null);
      allow update: if isAdmin() || 
                       (isAuthenticated() && 
                        get(/databases/$(database)/documents/locations/$(locationId)).data.deviceId == 
                        request.resource.data.deviceId);
      allow delete: if isAdmin();
    }
    
    // Audit logs - only admins can write, all authenticated can read their own
    match /auditLogs/{logId} {
      allow read: if isAuthenticated() && 
                     (isAdmin() || resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated();
      allow delete: if isAdmin();
    }
  }
}
